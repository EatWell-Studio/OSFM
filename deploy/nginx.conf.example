# Example nginx site for an OSFM instance behind nginx instead of Caddy, see docs/self-hosting.md ("nginx"). Replace
# food.example.org with your host name: OSFM_PUBLIC_URL must be exactly the URL members open
# (https://food.example.org). The certificate paths are those of certbot; a control panel keeps its own.
#
# Not yet verified on a server; checked locally with nginx 1.31 in front of OSFM (syntax, headers, compression,
# X-Forwarded-For).

server {
    listen 80;
    listen [::]:80;
    server_name food.example.org;

    # Certificate challenges over HTTP (certbot --webroot, or your panel), everything else to HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # nginx 1.25.1 and later; older versions: "listen 443 ssl http2;" and no "http2 on;".
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name food.example.org;

    ssl_certificate     /etc/letsencrypt/live/food.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/food.example.org/privkey.pem;

    # OSFM does not compress its responses. Basemap tiles arrive compressed already (with their own
    # Content-Encoding) and are left alone.
    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    # Only the small JSON bodies of the API are sent to OSFM.
    client_max_body_size 1m;

    # Everything goes to OSFM: no other location blocks. In particular no blocks that serve *.js, *.css or images
    # from a local directory or set their caching: OSFM serves them itself, with the right caching headers.
    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # One address, the one nginx received the request from; OSFM reads it with
        # OSFM_TRUSTED_PROXY_HEADERS=X-Forwarded-For. Behind Cloudflare's proxy, $remote_addr is the client's address
        # only with the real_ip settings below.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # OSFM sends its own security headers (Content-Security-Policy, HSTS for this host and others) and the session
        # cookie; nginx passes them through unchanged. Add no add_header, proxy_hide_header or proxy_cookie_* directives
        # for them, and no CORS headers. Optional HSTS for all subdomains instead of OSFM's (hard to undo):
        # proxy_hide_header Strict-Transport-Security;
        # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    # Only behind Cloudflare's proxy (orange cloud), see docs/self-hosting.md ("Cloudflare"): take the client's address
    # from CF-Connecting-IP, but only from Cloudflare's own addresses. Keep the list current from
    # https://www.cloudflare.com/ips/ (these are examples of its format, not the full list).
    # set_real_ip_from 173.245.48.0/20;
    # set_real_ip_from 2400:cb00::/32;
    # real_ip_header CF-Connecting-IP;
}
