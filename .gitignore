# ---------------------------------------------------------------------------------------------------------------------
# OSFM build output and local runtime data
# ---------------------------------------------------------------------------------------------------------------------
# web/dist/app is generated by `pnpm build`; web/dist/placeholder is tracked so that the Go code compiles without a
# frontend build (see web/embed.go). These lines come after the generic "dist/" rule above on purpose.
!/web/dist/
/web/dist/*
!/web/dist/placeholder/

# Local PocketBase data directory and the built binary
pb_data/
/osfm
